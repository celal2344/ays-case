# Copy to .env.development. Names only here; never commit real values.
# Transaction pooler (port 6543), used by the running API
DATABASE_URL=
# Session pooler (port 5432), used by migrations, the seed and DB tests
DATABASE_URL_SESSION=
LOG_LEVEL=debug
# Set a random string of at least 32 characters (for example: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Optional locally: defaults to http://localhost:5173 (the Vite dev server that proxies /api)
BETTER_AUTH_URL=
