{
  "name": "@ays/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development src/dev.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "tsx --env-file=.env.development src/scripts/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.production src/scripts/migrate.ts",
    "auth:generate": "auth generate --config src/auth/cli.ts --output src/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@ays/validators": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.16",
    "@hono/node-server": "2.1.6",
    "@scalar/hono-api-reference": "0.12.17",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.7.16",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "hono-openapi": "1.5.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "auth": "1.7.16",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
