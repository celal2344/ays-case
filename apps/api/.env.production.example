# Copy to .env.production. Only used to run migrations from a developer machine;
# the deployed API reads these from the Vercel dashboard. Never commit real values.
# Transaction pooler (port 6543)
DATABASE_URL=
# Session pooler (port 5432), used by migrations
DATABASE_URL_SESSION=
WEB_ORIGIN=https://ayscase.vercel.app
LOG_LEVEL=info
